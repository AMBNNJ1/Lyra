CLERK_PUBLISHABLE_KEY=
# Copy to .env and fill in values
LETTA_API_KEY=
VTS_URL=ws://127.0.0.1:8001
VTS_PLUGIN_NAME=NovaLink
VTS_DEVELOPER=YourName
# Select TTS engine: kokoro
TTS_ENGINE=kokoro

# Kokoro TTS (hexgrad/Kokoro-82M)
# Set TTS_ENGINE=kokoro in config.yaml or env to use this engine
KOKORO_VOICE=af_heart
KOKORO_LANG=a

# OpenAI-compatible local server (LM Studio / vLLM / Ollama / LocalAI)
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=

# Offline mode for Hugging Face/Transformers
# Set these to prevent any network calls; ensure model ids are local paths.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# HF_HOME=D:\hf-cache

# Web search providers
# Prefer Brave if set; falls back to Serper
# BRAVE_SUBSCRIPTION_TOKEN=your-brave-key
# SERPER_API_KEY=your-serper-key

# Memory (RAG) configuration

# Options: local | qdrant | stub
MEMORY_PROVIDER=qdrant
MEMORY_DB_PATH=.data/memory.sqlite
MEMORY_TOP_K=24
MEMORY_WORKING_TURNS=12
MEMORY_IMPORTANCE_THRESHOLD=6
MEMORY_MULTI_USER=1
MEMORY_STORE_SUMMARIES_ONLY=1
MEMORY_USER_ID=default
MEMORY_BUDGET_TOKENS=1024

# Qdrant (remote vector DB)
QDRANT_URL=https://YOUR-QDRANT-ENDPOINT:6333
QDRANT_API_KEY=your-api-key
QDRANT_COLLECTION=memory_items
# Adjust to your embedding model dimension (e.g., 384 for MiniLM, 768 for default BGE-small)
QDRANT_DIM=768
# Cosine | Dot | Euclid
QDRANT_DISTANCE=Cosine

# Local SQLite fallback
MEMORY_DB_PATH=.data/memory.sqlite

# Optional local embedding/reranker models (Sentence-Transformers names or local paths)
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
# MEMORY_FAISS_PATH=.data/faiss.index

# Auto memory extraction
# MEMORY_AUTO_ENABLE=1
# MEMORY_AUTO_IMPORTANCE_THRESHOLD=6
# MEMORY_AUTO_MAX_ITEMS=4
# MEMORY_AUTO_ALLOW_GENERAL_FROM_AUTO=0
# MEMORY_AUTO_VERBOSE=0

# Dedup / consolidation (local memory)
# MEMORY_DEDUP_ENABLE=1
# MEMORY_DEDUP_VECTOR_THRESHOLD=0.9
# MEMORY_DEDUP_LEXICAL_THRESHOLD=0.85
# MEMORY_GENERAL_FROM_INDEX_ONLY=1
# MEMORY_CONSOLIDATE_ENABLE=1
# MEMORY_DECAY_DAYS=30
# MEMORY_DECAY_AMOUNT=1

# Qdrant consolidation / promotion
# MEMORY_PROMOTE_MIN_MENTIONS=3
# MEMORY_PROMOTE_MIN_IMPORTANCE=6

# Clerk authentication
CLERK_ISSUER=
# Optional: override JWKS URL (defaults to {CLERK_ISSUER}/.well-known/jwks.json)
# CLERK_JWKS_URL=
# Optional audience claim
# CLERK_JWT_AUDIENCE=
# Base URL for Mem0 bridge (defaults to http://127.0.0.1:4040)
MEM0_BASE_URL=http://127.0.0.1:4040
