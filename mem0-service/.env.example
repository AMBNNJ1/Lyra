QDRANT_URL=https://your-qdrant-host:6333
QDRANT_API_KEY=your-qdrant-key
QDRANT_COLLECTION=memory_items
QDRANT_DIM=1536
QDRANT_DISTANCE=Cosine
MEM0_PORT=4040
MEM0_EMBED_PROVIDER=lmstudio
MEM0_EMBED_MODEL=text-embedding-qwen3-embedding-0.6b
MEM0_LLM_PROVIDER=lmstudio
MEM0_LLM_MODEL=qwen2.5:14b-instruct
MEM0_LLM_STRUCTURED_MODEL=qwen2.5:14b-instruct
MEM0_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
MEM0_LMSTUDIO_API_KEY=lmstudio
# Optional: switch back to Ollama by setting MEM0_EMBED_PROVIDER=ollama and MEM0_LLM_PROVIDER=ollama
# MEM0_OLLAMA_URL=http://127.0.0.1:11434
